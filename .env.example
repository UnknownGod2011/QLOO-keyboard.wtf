# Developer fallbacks for QLOO Jarvis. Copy values into your shell or user environment;
# never commit real keys. The desktop app prefers keys stored through Settings (Windows DPAPI).

# Qloo hackathon key (used only when no key is stored in %LOCALAPPDATA%\QLOO\qloo-api-v1.dat)
QLOO_API_KEY=
# Optional override; must be https. Hackathon keys only work against this host.
QLOO_API_BASE_URL=https://hackathon.api.qloo.com

# Optional isolated profile directory (must be inside %LOCALAPPDATA%)
QLOO_APPDATA_DIR=

# Optional connector relay (set both or neither)
QLOO_CONNECTOR_BACKEND_URL=
QLOO_CONNECTOR_WEB_URL=

# The Gemini key is entered in Settings > Personal Gemini API (native dialog, DPAPI); there is no
# environment fallback for the desktop app. The hosted web demo uses demo/web/.env.example.
