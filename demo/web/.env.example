# Copy to .env (local dev only; never commit real values).
# On Vercel set these with `vercel env add <NAME>` instead.
QLOO_API_KEY=
GEMINI_API_KEY=
QLOO_API_BASE_URL=https://hackathon.api.qloo.com
GEMINI_MODEL=gemini-3.5-flash
# 1 = fully offline synthetic fixtures (no network, no keys needed)
DEMO_MOCK=0
# Optional: per-instance daily cap on outbound Qloo HTTP calls (default 300)
QLOO_DAILY_BUDGET=300
